# (선택) config.yaml에서 summarizer: api 로 바꿀 때만 필요.
# 기본값(claude_code)은 로그인된 Claude Code 구독을 쓰므로 비워두세요.
ANTHROPIC_API_KEY=

# Notion 통합(integration) 시크릿
NOTION_TOKEN=ntn_...
# 논문 데이터베이스 ID (init_db 실행 시 자동으로 채워짐)
NOTION_DATABASE_ID=
# init_db가 데이터베이스를 만들 부모 페이지 ID
NOTION_PARENT_PAGE_ID=
# (선택) 다이제스트 페이지를 둘 부모 페이지. 비우면 데이터베이스의 부모 페이지를 사용
NOTION_DIGEST_PARENT_PAGE_ID=

# (선택) Semantic Scholar API 키 - 없어도 동작하지만 rate limit이 훨씬 빡빡함
S2_API_KEY=
